# ── Site ────────────────────────────────────────────────────────────
# Den offentlige adresse. Bruges til SEO, sitemap og delingsbilleder.
# På Vercel udfyldes den automatisk, hvis den ikke er sat.
NEXT_PUBLIC_SITE_URL=https://example.dk

# ── Booking-mails (Resend) ─────────────────────────────────────────
# Uden RESEND_API_KEY bliver bookinger kun logget i udvikling,
# og formularen viser en fejl i produktion (så ingen bookinger forsvinder).
RESEND_API_KEY=re_...
RESEND_FROM=Atelier Copenhagen <kontakt@ditdomæne.dk>
RESEND_TO=kontakt@ditdomæne.dk
